@{
    Layout = "_Layout";
    ViewBag.Titulo = "Um pouco de organização. Mais leveza no dia.";
}
<section class="shopping-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <span class="eyebrow"><span class="status-dot"></span> Menos improviso, mais tranquilidade</span>
        <h2 id="hero-title">Boas compras<br>começam <em>na lista.</em></h2>
        <p>Do que falta na despensa ao que não pode faltar na semana. Organize tudo em um só lugar e vá às compras com calma.</p>
        <div class="d-flex flex-wrap gap-3">
            <a class="btn btn-lime btn-lg" asp-controller="ListaCompras" asp-action="Cadastrar"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Criar minha lista</a>
            <a class="hero-secondary" asp-controller="ListaCompras" asp-action="Listar">Ver minhas listas <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a>
        </div>
        <span class="hero-note"><i class="bi bi-check2-circle me-2" aria-hidden="true"></i>Planeje. Organize. Leve só o que precisa.</span>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="art-orbit"></div>
        <img src="~/images/shopping-bag.svg" class="bag-illustration" alt="" width="360" height="360">
        <div class="art-label label-top"><span class="mini-check">✓</span> Tudo anotado!</div>
        <div class="art-label label-bottom"><i class="bi bi-basket2"></i> Uma compra mais leve.</div>
    </div>
</section>
<section class="workspace-section" aria-labelledby="workspace-title">
    <div class="section-heading"><div><span class="eyebrow">Seu espaço</span><h2 id="workspace-title">Tudo no seu lugar.</h2></div><p>Um passo de cada vez, uma compra melhor.</p></div>
    <div class="row g-4">
        <div class="col-md-4"><a class="workspace-card" asp-controller="ListaCompras" asp-action="Listar"><span class="module-icon icon-green"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span><span class="card-arrow" aria-hidden="true">↗</span><h3>Minhas listas</h3><p>Planeje a próxima compra e acompanhe seus valores estimados.</p><span class="card-link">Abrir listas <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a></div>
        <div class="col-md-4"><a class="workspace-card" asp-controller="Produto" asp-action="Listar"><span class="module-icon icon-peach"><i class="bi bi-basket2" aria-hidden="true"></i></span><span class="card-arrow" aria-hidden="true">↗</span><h3>Meus produtos</h3><p>Tenha os produtos do dia a dia à mão, com unidades e preços.</p><span class="card-link">Explorar produtos <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a></div>
        <div class="col-md-4"><a class="workspace-card" asp-controller="Categoria" asp-action="Listar"><span class="module-icon icon-purple"><i class="bi bi-grid" aria-hidden="true"></i></span><span class="card-arrow" aria-hidden="true">↗</span><h3>Categorias</h3><p>Cada coisa no seu grupo. Organize os produtos do seu jeito.</p><span class="card-link">Ver categorias <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a></div>
    </div>
</section>
<aside class="shopping-tip"><span class="tip-icon"><i class="bi bi-lightbulb" aria-hidden="true"></i></span><p><strong>Uma dica antes de sair</strong>Confira a despensa e a geladeira antes de montar sua lista. Seu bolso agradece.</p><span class="tip-decoration" aria-hidden="true">✳</span></aside>
