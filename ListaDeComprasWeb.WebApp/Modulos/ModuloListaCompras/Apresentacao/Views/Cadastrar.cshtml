@model ListaDeComprasWeb.WebApp.Modulos.ModuloListaCompras.Apresentacao.CadastrarListaComprasViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Criar lista de compras";
}

<a class="back-link" asp-action="Listar"><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar para minhas listas</a>
<div class="row g-4 list-create-layout">
    <div class="col-lg-7">
        <section class="card list-create-card" aria-labelledby="create-title">
            <div class="card-body p-4 p-md-5">
                <span class="module-icon icon-green"><i class="bi bi-clipboard2-plus" aria-hidden="true"></i></span>
                <span class="eyebrow">Um novo começo</span>
                <h2 id="create-title" class="h3 fw-bold">Qual é a próxima compra?</h2>
                <p class="text-body-secondary mb-4">Dê um nome à sua lista para encontrá-la facilmente depois.</p>
                <form asp-action="Cadastrar" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="Nome" class="form-label fw-semibold">Nome da lista <span class="text-body-secondary fw-normal">(obrigatório)</span></label>
                        <input asp-for="Nome" class="form-control form-control-lg" placeholder="Ex.: Compras da semana" minlength="3" maxlength="100" required aria-describedby="nome-ajuda nome-erro" aria-invalid="@(ViewData.ModelState[nameof(Model.Nome)]?.Errors.Count > 0 ? "true" : null)" />
                        <div id="nome-ajuda" class="form-text">Use entre 3 e 100 caracteres. Pode ser uma ocasião, um mercado ou um período.</div>
                        <span id="nome-erro" asp-validation-for="Nome" class="text-danger small" role="alert"></span>
                    </div>
                    <div class="list-create-info">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <p>A lista começa com o status <strong>Aberta</strong>. A data de criação é registrada automaticamente.</p>
                    </div>
                    <div class="list-form-actions">
                        <a class="btn btn-outline-secondary" asp-action="Listar">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Criar lista</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <aside class="list-create-aside" aria-labelledby="planning-title">
            <img src="~/images/shopping-bag.svg" width="200" height="200" alt="" />
            <span class="eyebrow">Compras com leveza</span>
            <h2 id="planning-title">Uma boa lista faz<br>toda a diferença.</h2>
            <p>Reserve um momento para conferir o que falta em casa. Assim, você se organiza antes de sair.</p>
            <div class="list-name-tip"><i class="bi bi-lightbulb" aria-hidden="true"></i><div><strong>Um nome que faça sentido para você</strong><span>“Feira de sábado”, “Compras do mês” ou “Churrasco em família”.</span></div></div>
        </aside>
    </div>
</div>
