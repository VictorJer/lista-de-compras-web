@using ListaDeComprasWeb.WebApp.Modulos.ModuloListaCompras.Dominio
@model List<ListaDeComprasWeb.WebApp.Modulos.ModuloListaCompras.Apresentacao.ListarListasComprasViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listas de compras";
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger" role="alert">@mensagemErro</div>
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Listas cadastradas</h2>
        <p class="text-body-secondary mb-0">Acompanhe suas compras e os valores estimados.</p>
    </div>

    <div class="d-flex align-items-center gap-3">
        <span class="badge rounded-pill text-bg-primary">
            @Model.Count lista(s)
        </span>
        <a class="btn btn-primary" asp-action="Cadastrar">
            <i class="bi bi-plus-lg me-2"></i>Nova lista
        </a>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-clipboard2-check display-5 text-body-secondary"></i>
            <h3 class="h5 mt-3">Nenhuma lista cadastrada</h3>
            <p class="text-body-secondary mb-3">Crie uma lista para começar a organizar suas compras.</p>
            <a class="btn btn-primary" asp-action="Cadastrar">
                <i class="bi bi-plus-lg me-2"></i>Criar primeira lista
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Lista</th>
                        <th scope="col">Criada em</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Itens</th>
                        <th scope="col" class="text-end">Total estimado</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lista in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@lista.Nome</td>
                            <td class="text-nowrap">@lista.DataCriacao.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (lista.Status == StatusListaCompras.Aberta)
                                {
                                    <span class="badge text-bg-success">Aberta</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Concluída</span>
                                }
                            </td>
                            <td class="text-end">@lista.TotalItens</td>
                            <td class="text-end text-nowrap">@lista.TotalEstimado.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                            <td class="text-end">
                                <div class="btn-group" role="group" aria-label="Ações da lista @lista.Nome">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@lista.Id">
                                        <i class="bi bi-pencil me-1"></i>Editar
                                    </a>
                                    @if (lista.Status == StatusListaCompras.Aberta)
                                    {
                                        <a class="btn btn-sm btn-outline-success" asp-action="Concluir" asp-route-id="@lista.Id">
                                            <i class="bi bi-check-lg me-1"></i>Concluir
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>