@model ListaDeComprasWeb.WebApp.ModuloCategoria.Apresentacao.CadastrarCategoriaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastrar categoria";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h2 class="h5 fw-bold mb-1">Nova categoria</h2>
                <p class="text-body-secondary mb-0">Cadastre uma categoria para organizar seus produtos.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Cadastrar" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold">Nome</label>
                        <input asp-for="Nome" class="form-control" maxlength="50" autofocus />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Cor" class="form-label fw-semibold">Cor</label>
                        <div class="input-group">
                            <input id="CorPicker" type="color" class="form-control form-control-color" value="@Model.Cor" title="Escolha uma cor" onchange="document.getElementById('Cor').value = this.value" />
                            <input asp-for="Cor" type="text" class="form-control" maxlength="30" />
                        </div>
                        <span asp-validation-for="Cor" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Listar">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Cadastrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>