@model ListaDeComprasWeb.WebApp.ModuloCategoria.Apresentacao.ExcluirCategoriaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir categoria";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="h5 fw-bold mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Excluir categoria</h2>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <p>Tem certeza de que deseja excluir a categoria <strong>@Model.Nome</strong>?</p>
                <p class="text-body-secondary">Esta ação não poderá ser desfeita. Categorias com produtos vinculados não podem ser excluídas.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-3">Nome</dt>
                    <dd class="col-sm-9">@Model.Nome</dd>
                    <dt class="col-sm-3">Cor</dt>
                    <dd class="col-sm-9">
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="rounded-circle border color-preview" style="background-color: @Model.Cor;" aria-hidden="true"></span>
                            @Model.Cor
                        </span>
                    </dd>
                </dl>

                <form asp-action="Excluir" method="post" class="d-flex justify-content-end gap-2">
                    <input asp-for="Id" type="hidden" />
                    <a class="btn btn-outline-secondary" asp-action="Listar">Cancelar</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Excluir categoria
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>