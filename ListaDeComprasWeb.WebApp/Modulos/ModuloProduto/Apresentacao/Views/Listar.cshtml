@model List<ListarProdutosViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Produtos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Produtos cadastrados</h2>
        <p class="text-body-secondary mb-0">Consulte e mantenha os produtos da sua lista.</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="badge rounded-pill text-bg-primary">
            @Model.Count produto(s)
        </span>
        <a class="btn btn-primary" asp-action="Cadastrar">
            <i class="bi bi-plus-lg me-2"></i>Novo produto
        </a>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-basket2 display-5 text-body-secondary"></i>
            <h3 class="h5 mt-3">Nenhum produto cadastrado</h3>
            <p class="text-body-secondary mb-3">Cadastre um produto para começar a organizar suas compras.</p>
            <a class="btn btn-primary" asp-action="Cadastrar">
                <i class="bi bi-plus-lg me-2"></i>Cadastrar primeiro produto
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Produto</th>
                        <th scope="col">Categoria</th>
                        <th scope="col">Unidade</th>
                        <th scope="col" class="text-end">Preço aproximado</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var produto in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@produto.Nome</td>
                            <td>
                                <span class="d-inline-flex align-items-center gap-2">
                                    <span class="rounded-circle border color-preview" style="background-color: @produto.CategoriaCor;" aria-hidden="true"></span>
                                    <span>@produto.CategoriaNome</span>
                                </span>
                            </td>
                            <td>@produto.UnidadeMedida</td>
                            <td class="text-end text-nowrap">@produto.PrecoAproximado.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                            <td class="text-end">
                                <div class="btn-group" role="group" aria-label="Ações do produto @produto.Nome">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@produto.Id">
                                        <i class="bi bi-pencil me-1"></i>Editar
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@produto.Id">
                                        <i class="bi bi-trash me-1"></i>Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>