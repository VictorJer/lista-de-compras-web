@model EditarProdutoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar produto";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h2 class="h5 fw-bold mb-1">Editar produto</h2>
                <p class="text-body-secondary mb-0">Atualize os dados do produto selecionado.</p>
            </div>

            <div class="card-body p-4">
                <form asp-action="Editar" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @if (Model.Categorias.Count == 0)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            Cadastre uma categoria antes de alterar a categoria deste produto.
                            <a class="alert-link" asp-controller="Categoria" asp-action="Cadastrar">Cadastrar categoria</a>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold">Nome</label>
                        <input asp-for="Nome" class="form-control" maxlength="100" minlength="2" autofocus />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategotriaId" class="form-label fw-semibold">Categoria</label>
                        <select asp-for="CategotriaId" class="form-select" disabled="@(Model.Categorias.Count == 0)">
                            <option value="">Selecione uma categoria</option>
                            @foreach (var categoria in Model.Categorias)
                            {
                                <option value="@categoria.Id">@categoria.Nome</option>
                            }
                        </select>
                        <span asp-validation-for="CategotriaId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UnidadeMedida" class="form-label fw-semibold">Unidade de medida</label>
                        <select asp-for="UnidadeMedida" asp-items="Html.GetEnumSelectList<ListaDeComprasWeb.WebApp.Modulos.ModuloProduto.Dominio.UnidadeMedida>()" class="form-select"></select>
                        <span asp-validation-for="UnidadeMedida" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PrecoAproximado" class="form-label fw-semibold">Preço aproximado</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input asp-for="PrecoAproximado" type="number" class="form-control" min="0.01" step="0.01" />
                        </div>
                        <span asp-validation-for="PrecoAproximado" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Listar">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Salvar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>